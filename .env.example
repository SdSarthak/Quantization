# Copy to .env and adjust. Every variable is optional; the defaults shown here
# are what the service uses when the variable is absent.
# .env is gitignored - never commit real tokens.

# --- Model ---------------------------------------------------------------
AIRAVATA_MODEL_NAME=ai4bharat/Airavata
AIRAVATA_CACHE_DIR=./model_cache
AIRAVATA_QUANTIZED_MODEL_PATH=./quantized_models
AIRAVATA_BENCHMARK_DIR=./benchmarks

# Hugging Face access token, required only for gated or private repositories.
# Replace with your own token; HF_TOKEN / HUGGING_FACE_HUB_TOKEN also work.
AIRAVATA_HF_TOKEN=hf_your_token_here

# --- Runtime -------------------------------------------------------------
# auto | cpu | cuda
AIRAVATA_DEVICE=auto
AIRAVATA_HOST=127.0.0.1
AIRAVATA_PORT=8000
AIRAVATA_MAX_WORKERS=4
AIRAVATA_LOG_LEVEL=INFO

# Variants to load at startup. "auto" loads everything the detected device
# supports, "none" defers loading until the first request, or give a comma
# separated list such as "original,int4".
AIRAVATA_PRELOAD=auto

# Mixed precision autocast for the FP baseline on CUDA.
AIRAVATA_USE_AMP=true

# Airavata ships custom modeling code; set to false to refuse executing it.
AIRAVATA_TRUST_REMOTE_CODE=true

# --- Request limits ------------------------------------------------------
AIRAVATA_MAX_INPUT_TOKENS=512
AIRAVATA_MAX_NEW_TOKENS=2048
AIRAVATA_MAX_RETURN_SEQUENCES=10
