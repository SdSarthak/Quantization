# CPU image: no CUDA, so only the "original" and "dynamic_quant" variants load.
FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/models/hf \
    AIRAVATA_HOST=0.0.0.0 \
    AIRAVATA_PORT=8000 \
    AIRAVATA_DEVICE=cpu \
    AIRAVATA_CACHE_DIR=/models/cache \
    AIRAVATA_QUANTIZED_MODEL_PATH=/models/quantized \
    AIRAVATA_BENCHMARK_DIR=/models/benchmarks

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt ./
# The CPU wheel index keeps the image an order of magnitude smaller, and
# bitsandbytes/accelerate are not needed without a GPU.
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && grep -viE '^(torch|accelerate|bitsandbytes)' requirements.txt > /tmp/cpu-requirements.txt \
    && pip install --no-cache-dir -r /tmp/cpu-requirements.txt

COPY pyproject.toml README.md ./
COPY airavata_quant ./airavata_quant
COPY airavata_quantization_service.py ./
RUN pip install --no-cache-dir --no-deps -e .

VOLUME ["/models"]
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=300s --retries=5 \
    CMD curl -fsS http://localhost:8000/health || exit 1

ENTRYPOINT ["python", "-m", "airavata_quant"]
CMD ["serve"]
